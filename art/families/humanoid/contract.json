    "chains": {
      "mantle_l": "Mantle_L_01..Mantle_L_04",
      "mantle_r": "Mantle_R_01..Mantle_R_04",
      "tail": "Tail_01..Tail_08",
      "ear_l": "Ear_L_01..Ear_L_02",
      "ear_r": "Ear_R_01..Ear_R_02"
    },
    "chainParents": {
      "mantle_l": "LeftUpperArm",
      "mantle_r": "RightUpperArm",
