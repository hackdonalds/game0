      "Neck": "Head",
      "LeftShoulder": "LeftUpperArm",
      "LeftUpperArm": "LeftLowerArm",
      "LeftLowerArm": "LeftHand",
      "LeftHand": "LeftMiddleProximal",
      "RightShoulder": "RightUpperArm",
      "RightUpperArm": "RightLowerArm",
      "RightLowerArm": "RightHand",
      "RightHand": "RightMiddleProximal",
      "LeftUpperLeg": "LeftLowerLeg",
      "LeftLowerLeg": "LeftFoot",
      "LeftFoot": "LeftToes",
      "RightUpperLeg": "RightLowerLeg",
      "RightLowerLeg": "RightFoot",
      "RightFoot": "RightToes"
    },
    "maxInfluences": 4,
    "limits": {
      "LeftLowerLeg": 125,
      "RightLowerLeg": 125
    },
    "limitsNote": "max bend in degrees between a bone's parent limb and its own limb; retarget clamps clips to it (a 150 degree heel kick folds the shin into the seat of any trousers)"
  },
  "sockets": [
    {
      "name": "Socket_Grip_R",
      "bone": "RightHand",
      "from": [
        "RightHand"
      ],
      "comment": "palm centre; held props put their Grip origin here"
