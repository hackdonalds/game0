      "primary",
      "secondary",
      "accent"
    ],
    "encoding": "<asset>.dye.png next to the GLB; R = primary, G = secondary, B = accent, black = never dyed",
    "blend": "dyed = mix(albedo, luminance(albedo) * dyeColour * 1.6, mask)"
  },
