{
  "family": "humanoid",
  "description": "Every playable people and humanoid NPC. One base mesh (MPFB2, CC0), one skeleton, one gear kit.",
  "units": "metres; glTF +Y up, +Z front (Blender -Y front)",
  "rest": {
    "pose": "A-pose, arms ~45 degrees down, palms in, feet shoulder-width",
    "boneAxes": "every bone points straight up (+Z in Blender, roll 0), so all bodies share identical local rest rotations and clips play on any body without runtime retargeting"
  },
  "skeleton": {
    "profile": "Godot SkeletonProfileHumanoid names",
    "core": [
      "Hips",
      "Spine",
      "Chest",
      "Neck",
