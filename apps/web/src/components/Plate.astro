---
// A painted plate, or a lettered placeholder until scripts/handbook-art.ts has generated it.
import { Image } from "astro:assets";
import { plate } from "../lib/art";

interface Props { art: string; name: string; sizes: string; eager?: boolean; wide?: boolean; tone?: string; class?: string }
const { art, name, sizes, eager = false, wide = false, tone = "var(--teal)", class: cls = "" } = Astro.props;
const src = plate(art);
---
{src ? (
  <Image class:list={["plate", "plate-img", { wide }, cls]} src={src} alt={`Painting: ${name}`} widths={wide ? [480, 960, 1600] : [240, 480, 960]} sizes={sizes} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} />
) : (
  <div class:list={["plate", "placeholder", { wide }, cls]} style={`--tone:${tone}`} role="img" aria-label={`${name}, painting to come`}>
    <span class="initial">{name.replace(/^The /, "").charAt(0)}</span>
  </div>
)}

<style>
  /* <Image> renders outside this component's scope, so its class is styled globally */
  :global(img.plate-img), .plate { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 10px; background: var(--paper-deep); }
  :global(img.plate-img.wide), .plate.wide { aspect-ratio: 16 / 9; }
  .placeholder {
    position: relative; display: grid; place-items: center; container-type: inline-size;
    background: radial-gradient(circle at 50% 42%, var(--card) 0%, var(--paper-deep) 75%);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 0 0 6px var(--paper), inset 0 0 0 7px color-mix(in srgb, var(--tone) 45%, transparent);
  }
  .initial { font-family: var(--font-display); font-size: 38cqi; font-weight: 600; line-height: 1; color: color-mix(in srgb, var(--tone) 70%, var(--ink)); }
  .wide .initial { font-size: 20cqi; }
</style>
