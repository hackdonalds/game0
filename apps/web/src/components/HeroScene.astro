<canvas id="hero-scene" aria-hidden="true"></canvas>

<script>
  import * as THREE from "three";

  const canvas = document.getElementById("hero-scene") as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

  const scene = new THREE.Scene();
  scene.fog = new THREE.Fog(0x12261f, 12, 30);
  const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
  camera.position.set(0, 4, 14);
  camera.lookAt(0, 1, 0);

  scene.add(new THREE.HemisphereLight(0xfff3d6, 0x0e5a57, 1.6));
  const sun = new THREE.DirectionalLight(0xffe2a8, 2.2);
  sun.position.set(5, 10, 4);
  scene.add(sun);

  // Placeholder floating isle until Meshy assets land
  const isle = new THREE.Group();
  const rock = new THREE.Mesh(new THREE.ConeGeometry(3, 4, 9), new THREE.MeshStandardMaterial({ color: 0x6b5a45, flatShading: true }));
  rock.rotation.x = Math.PI;
  rock.position.y = -2;
  const grass = new THREE.Mesh(new THREE.CylinderGeometry(3, 3, 0.3, 24), new THREE.MeshStandardMaterial({ color: 0x4f7a3a }));
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.6, 2.6, 8), new THREE.MeshStandardMaterial({ color: 0x7a5a3a, flatShading: true }));
  trunk.position.y = 1.4;
  const canopy = new THREE.Mesh(new THREE.IcosahedronGeometry(1.8, 1), new THREE.MeshStandardMaterial({ color: 0x7fa64a, flatShading: true }));
  canopy.position.y = 3.4;
  isle.add(rock, grass, trunk, canopy);
  scene.add(isle);

  const resize = () => {
    const { clientWidth: w, clientHeight: h } = canvas;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  };
  new ResizeObserver(resize).observe(canvas);

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  renderer.setAnimationLoop((t) => {
    if (!reduceMotion) {
      isle.rotation.y = t * 0.00015;
      isle.position.y = Math.sin(t * 0.0008) * 0.25;
    }
    renderer.render(scene, camera);
  });
</script>

<style>
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
