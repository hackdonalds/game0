---
// A filterable grid of catalogue cards: search plus facet chips (any value within a facet, all facets together).
import Plate from "./Plate.astro";
import type { Card } from "../lib/catalogues";

interface Props { cards: Card[]; filters?: string[]; label: string }
const { cards, filters = [], label } = Astro.props;
const facetValues = Object.fromEntries(filters.map((f) => [f, [...new Set(cards.map((c) => c.facets[f]).filter(Boolean))].sort()]));
const hasArt = cards.some((c) => c.art);
---
<div class="card-grid" data-grid>
  <div class="filters">
    <input type="search" placeholder={`Search ${label.toLowerCase()}…`} aria-label={`Search ${label}`} data-q />
    {filters.map((f) => (
      <div class="facet" role="group" aria-label={f}>
        {facetValues[f].map((v) => <button type="button" data-facet={f} data-value={v} aria-pressed="false">{v}</button>)}
      </div>
    ))}
    <p class="count" aria-live="polite"><span data-count>{cards.length}</span> of {cards.length}</p>
  </div>
  <ul class:list={["grid", { text: !hasArt }]}>
    {cards.map((c) => (
      <li data-search={c.search} data-facets={JSON.stringify(c.facets)}>
        <a href={c.href}>
          {hasArt && <Plate art={c.art} name={c.name} tone={c.tone} sizes="(max-width: 640px) 45vw, 240px" />}
          <span class="meta">
            {c.badges?.length ? <span class="badges">{c.badges.map((b) => <span class:list={["chip", b.class]}>{b.label}</span>)}</span> : null}
            <b>{c.name}</b>
            {c.subtitle && <span class="sub">{c.subtitle}</span>}
            {!hasArt && c.summary && <span class="sum">{c.summary}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="empty" hidden>Nothing matches. Try fewer filters.</p>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>("[data-grid]")) {
    const items = [...el.querySelectorAll<HTMLElement>("li")].map((li) => ({ li, text: li.dataset.search ?? "", facets: JSON.parse(li.dataset.facets ?? "{}") as Record<string, string> }));
    const q = el.querySelector<HTMLInputElement>("[data-q]")!;
    const active = new Map<string, Set<string>>();
    const apply = () => {
      const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      let n = 0;
      for (const it of items) {
        const ok = words.every((w) => it.text.includes(w)) && [...active].every(([f, vals]) => !vals.size || vals.has(it.facets[f]));
        it.li.hidden = !ok;
        if (ok) n++;
      }
      el.querySelector("[data-count]")!.textContent = String(n);
      el.querySelector<HTMLElement>(".empty")!.hidden = n > 0;
    };
    q.addEventListener("input", apply);
    el.querySelectorAll<HTMLButtonElement>("[data-facet]").forEach((b) => b.addEventListener("click", () => {
      const on = b.getAttribute("aria-pressed") !== "true";
      b.setAttribute("aria-pressed", String(on));
      const set = active.get(b.dataset.facet!) ?? new Set();
      on ? set.add(b.dataset.value!) : set.delete(b.dataset.value!);
      active.set(b.dataset.facet!, set);
      apply();
    }));
  }
</script>

<style>
  .filters { position: sticky; top: 3.6rem; z-index: 5; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; padding: 0.75rem 0; margin-bottom: 1.25rem; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  input { flex: 1 1 14rem; min-width: 0; min-height: 42px; font: inherit; font-size: 0.95rem; padding: 0.45rem 0.9rem; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--ink); }
  .facet { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .facet button { font: 500 0.82rem var(--font-body); min-height: 36px; padding: 0.35rem 0.8rem; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--ink-soft); cursor: pointer; }
  .facet button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .count { margin: 0 0 0 auto; font-size: 0.82rem; color: var(--ink-faint); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(46%, 13rem), 1fr)); gap: clamp(0.9rem, 2.5vw, 1.5rem); }
  .grid.text { grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .grid a { display: grid; gap: 0.6rem; height: 100%; padding: 0.5rem; margin: -0.5rem; border-radius: 14px; text-decoration: none; color: var(--ink); transition: background 0.15s; }
  .grid a:hover { background: var(--card); }
  .grid a:hover b { color: var(--teal); }
  .text a { margin: 0; padding: 1rem 1.1rem; background: var(--card); box-shadow: 0 0 0 1px var(--line); }
  .meta { display: grid; gap: 0.15rem; }
  .badges { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.15rem; }
  .badges .chip { font-size: 0.7rem; padding: 0.05rem 0.5rem; }
  b { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; line-height: 1.2; }
  .sub { font-size: 0.82rem; color: var(--ink-soft); font-style: italic; }
  .sum { font-size: 0.9rem; color: var(--ink-soft); margin-top: 0.25rem; }
  .empty { padding: 2rem 0; color: var(--ink-soft); }
  @media (max-width: 820px) {
    .count { display: none; }
    /* Facet chips scroll sideways on phones so the filter bar stays short */
    .facet { flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 2px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .facet::-webkit-scrollbar { display: none; }
    .facet button { flex: none; }
  }
</style>
