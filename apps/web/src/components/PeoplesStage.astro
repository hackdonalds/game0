---
import { peoples } from "../data/peoples";
---
<canvas id="peoples-stage" data-lineup={peoples.map((p) => p.id).join(",")} aria-label="The five peoples of game0 standing in a ring, the chosen one at the front"></canvas>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

  type Option = { file: string; position: [number, number, number]; rotation: [number, number, number]; scale: number };
  type Config = { base: { file: string }; slots: Record<string, { bone: string; options: Record<string, Option> }> };

  const MODELS = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}models/`;
  const canvas = document.getElementById("peoples-stage") as HTMLCanvasElement;
  const LINEUP = canvas.dataset.lineup!.split(",");

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.1;
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 60);

  // Golden-hour light to match the concept paintings
  scene.add(new THREE.HemisphereLight(0xfff4dc, 0x6a8f9a, 2.2));
  const sun = new THREE.DirectionalLight(0xffd79a, 3);
  sun.position.set(4, 7, 5);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  sun.shadow.camera.left = sun.shadow.camera.bottom = -5;
  sun.shadow.camera.right = sun.shadow.camera.top = 5;
  sun.shadow.radius = 6;
  scene.add(sun, sun.target);
  const rim = new THREE.DirectionalLight(0x9fe9ff, 1.4);
  rim.position.set(-4, 3, -4);
  scene.add(rim);

  // Invisible floor that only catches shadows, so the lineup stands on the painted clouds
  const floor = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), new THREE.ShadowMaterial({ opacity: 0.22 }));
  floor.rotation.x = -Math.PI / 2;
  floor.receiveShadow = true;
  scene.add(floor);

  const BONE_ALIASES: Record<string, string> = { Spine02: "Spine2", Spine01: "Spine1" };
  const findBone = (root: THREE.Object3D, name: string) =>
    [name, `mixamorig${name}`, `mixamorig${BONE_ALIASES[name] ?? name}`].map((n) => root.getObjectByName(n)).find(Boolean);

  const loader = new GLTFLoader();
  const mixers: THREE.AnimationMixer[] = [];

  // Round carousel: everyone stands on a ring and it turns so the chosen people faces the camera
  const RADIUS = 2.4;
  const FOCUS_SCALE = 1.18;
  const ring = new THREE.Group();
  ring.position.z = -RADIUS;
  scene.add(ring);
  sun.position.z -= RADIUS;
  sun.target.position.set(0, 0, -RADIUS);
  const holders: THREE.Group[] = [];

  async function loadPeople(people: string) {
    const cfg: Config = await (await fetch(`${MODELS}${people}/attachments.json`)).json();
    const gltf = await loader.loadAsync(MODELS + cfg.base.file);
    const character = gltf.scene;

    // Each people gets a holder on the ring, facing outwards
    const slot = LINEUP.indexOf(people);
    const angle = (slot / LINEUP.length) * Math.PI * 2;
    const holder = new THREE.Group();
    holder.position.set(Math.sin(angle) * RADIUS, 0, Math.cos(angle) * RADIUS);
    holder.rotation.y = angle;
    holder.userData.slot = slot;
    holder.add(character);
    ring.add(holder);
    holders[slot] = holder;
    const box = new THREE.Box3().setFromObject(character);
    character.position.y -= box.min.y;
    character.updateMatrixWorld(true);

    // Default look: the first option in every slot
    for (const { bone: boneName, options } of Object.values(cfg.slots)) {
      const bone = findBone(character, boneName);
      const option = Object.values(options)[0];
      if (!bone || !option) continue;
      const socket = new THREE.Object3D();
      const s = bone.getWorldScale(new THREE.Vector3());
      socket.scale.set(1 / s.x, 1 / s.y, 1 / s.z);
      bone.add(socket);
      const part = (await loader.loadAsync(MODELS + option.file)).scene;
      part.position.fromArray(option.position);
      part.rotation.set(...(option.rotation.map(THREE.MathUtils.degToRad) as [number, number, number]));
      part.scale.setScalar(option.scale);
      socket.add(part);
    }
    character.traverse((o) => { if ((o as THREE.Mesh).isMesh) o.castShadow = true; });

    const mixer = new THREE.AnimationMixer(character);
    const idle = gltf.animations.find((c) => /idle/i.test(c.name)) ?? gltf.animations[0];
    if (idle) {
      const action = mixer.clipAction(idle).play();
      action.time = Math.random() * idle.duration;
    }
    mixers.push(mixer);
  }

  // The ring turns the shortest way round to bring the chosen people to the front
  let focus = Math.floor(LINEUP.length / 2);
  const step = (Math.PI * 2) / LINEUP.length;
  let target = -focus * step;
  ring.rotation.y = target;
  addEventListener("people:focus", (e) => {
    const next = (e as CustomEvent<number>).detail;
    let delta = (next - focus) % LINEUP.length;
    if (delta > LINEUP.length / 2) delta -= LINEUP.length;
    if (delta < -LINEUP.length / 2) delta += LINEUP.length;
    target -= delta * step;
    focus = next;
  });

  // Clicking someone on the ring selects their tab
  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  const pick = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    pointer.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
    raycaster.setFromCamera(pointer, camera);
    let o: THREE.Object3D | null = raycaster.intersectObjects(holders.filter(Boolean), true)[0]?.object ?? null;
    while (o && o.userData.slot === undefined) o = o.parent;
    return o ? (o.userData.slot as number) : -1;
  };
  canvas.addEventListener("click", (e) => {
    const slot = pick(e);
    if (slot >= 0) document.getElementById(`tab-${LINEUP[slot]}`)?.click();
  });
  canvas.addEventListener("pointermove", (e) => { canvas.style.cursor = pick(e) >= 0 ? "pointer" : ""; });

  const view = { distance: 9, lookY: 1 };
  const resize = () => {
    const { clientWidth: w, clientHeight: h } = canvas;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    const portrait = w / h < 1;
    Object.assign(view, portrait ? { distance: 11, lookY: 1.1 } : { distance: 7.6, lookY: 1.05 });
    camera.updateProjectionMatrix();
  };
  new ResizeObserver(resize).observe(canvas);
  resize();

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clock = new THREE.Clock();
  const look = new THREE.Vector3(0, 1, 0);
  const frame = () => {
    const dt = Math.min(clock.getDelta(), 0.1);
    if (!reduceMotion) mixers.forEach((m) => m.update(dt));
    const ease = reduceMotion ? 1 : 1 - Math.exp(-dt * 4);
    ring.rotation.y += (target - ring.rotation.y) * ease;
    holders.forEach((h, i) => {
      if (!h) return;
      const s = i === focus ? FOCUS_SCALE : 1;
      h.scale.setScalar(h.scale.x + (s - h.scale.x) * ease);
    });
    look.set(0, view.lookY, -RADIUS * 0.35);
    const sway = reduceMotion ? 0 : Math.sin(clock.elapsedTime * 0.15) * 0.06;
    camera.position.set(Math.sin(sway) * view.distance, 2.1, Math.cos(sway) * view.distance - RADIUS * 0.35);
    camera.lookAt(look);
    renderer.render(scene, camera);
  };

  // Load and render only once the stage scrolls near the viewport
  let loaded = false;
  new IntersectionObserver(async ([entry]) => {
    renderer.setAnimationLoop(entry.isIntersecting ? frame : null);
    if (!entry.isIntersecting || loaded) return;
    loaded = true;
    const available: string[] = await (await fetch(MODELS + "peoples.json")).json();
    const lineup = LINEUP.filter((p) => available.includes(p));
    await Promise.all(lineup.map((p) => loadPeople(p)));
    canvas.classList.add("ready");
  }, { rootMargin: "300px" }).observe(canvas);
</script>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  canvas.ready { opacity: 1; }
</style>
