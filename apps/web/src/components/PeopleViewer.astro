---
// Rotate one people's 3D model with touch or mouse. Loads when scrolled near.
interface Props { people: string }
const { people } = Astro.props;
---
<div class="viewer" data-viewer={people}>
  <canvas aria-label={`3D model of the ${people}. Drag to turn it.`}></canvas>
  <p class="hint">Drag to turn · pinch to zoom</p>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  type Option = { file: string; position: [number, number, number]; rotation: [number, number, number]; scale: number };
  type Config = { base: { file: string }; slots: Record<string, { bone: string; options: Record<string, Option> }> };
  const MODELS = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}models/`;
  const BONE_ALIASES: Record<string, string> = { Spine02: "Spine2", Spine01: "Spine1" };
  const findBone = (root: THREE.Object3D, name: string) =>
    [name, `mixamorig${name}`, `mixamorig${BONE_ALIASES[name] ?? name}`].map((n) => root.getObjectByName(n)).find(Boolean);

  async function mount(el: HTMLElement) {
    const canvas = el.querySelector("canvas")!;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    const scene = new THREE.Scene();
    scene.add(new THREE.HemisphereLight(0xfff4dc, 0x6a8f9a, 2.4));
    const sun = new THREE.DirectionalLight(0xffd79a, 2.6);
    sun.position.set(2, 4, 3);
    scene.add(sun);
    const camera = new THREE.PerspectiveCamera(32, 1, 0.05, 50);
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.enablePan = false;
    controls.autoRotate = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    controls.autoRotateSpeed = 1.2;

    const loader = new GLTFLoader();
    const id = el.dataset.viewer!;
    const available: string[] = await (await fetch(MODELS + "peoples.json")).json();
    if (!available.includes(id)) { el.classList.add("missing"); return; }
    const cfg: Config = await (await fetch(`${MODELS}${id}/attachments.json`)).json();
    const gltf = await loader.loadAsync(MODELS + cfg.base.file);
    const character = gltf.scene;
    scene.add(character);
    for (const { bone: boneName, options } of Object.values(cfg.slots)) {
      const bone = findBone(character, boneName), option = Object.values(options)[0];
      if (!bone || !option) continue;
      const socket = new THREE.Object3D();
      const s = bone.getWorldScale(new THREE.Vector3());
      socket.scale.set(1 / s.x, 1 / s.y, 1 / s.z);
      bone.add(socket);
      const part = (await loader.loadAsync(MODELS + option.file)).scene;
      part.position.fromArray(option.position);
      part.rotation.set(...(option.rotation.map(THREE.MathUtils.degToRad) as [number, number, number]));
      part.scale.setScalar(option.scale);
      socket.add(part);
    }
    const box = new THREE.Box3().setFromObject(character);
    const h = box.max.y - box.min.y;
    character.position.y -= box.min.y;
    controls.target.set(0, h * 0.55, 0);
    camera.position.set(h * 0.6, h * 0.75, h * 2.6);
    controls.minDistance = h * 1.2;
    controls.maxDistance = h * 4;
    const mixer = new THREE.AnimationMixer(character);
    const idle = gltf.animations.find((c) => /idle/i.test(c.name)) ?? gltf.animations[0];
    if (idle) mixer.clipAction(idle).play();

    const resize = () => {
      renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
      camera.aspect = canvas.clientWidth / canvas.clientHeight;
      camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(canvas);
    resize();
    const clock = new THREE.Clock();
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(el);
    renderer.setAnimationLoop(() => {
      if (!visible) return;
      mixer.update(Math.min(clock.getDelta(), 0.1));
      controls.update();
      renderer.render(scene, camera);
    });
    el.classList.add("ready");
  }

  document.querySelectorAll<HTMLElement>("[data-viewer]").forEach((el) => {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); mount(el); } }, { rootMargin: "200px" });
    io.observe(el);
  });
</script>

<style>
  .viewer { position: relative; aspect-ratio: 4 / 5; max-height: 70vh; border-radius: 14px; overflow: hidden; background: radial-gradient(circle at 50% 30%, #fffaf0, #e9dcc0); }
  canvas { width: 100%; height: 100%; display: block; touch-action: none; opacity: 0; transition: opacity 0.8s; }
  .ready canvas { opacity: 1; }
  .hint { position: absolute; bottom: 0.6rem; left: 0; right: 0; margin: 0; text-align: center; font-size: 0.75rem; color: #55606c; pointer-events: none; }
  .missing .hint::after { content: " · model coming soon"; }
</style>
