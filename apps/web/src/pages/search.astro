---
import Base from "../layouts/Base.astro";
import { base } from "../lib/text";
---
<Base title="Search · game0 handbook" section="search">
  <div class="wrap page">
    <h1>Search the handbook</h1>
    <input id="q" type="search" placeholder="Try “sinking”, “cliff goat” or “Windmarket”" aria-label="Search the handbook" autofocus autocomplete="off" />
    <p class="status" aria-live="polite"></p>
    <ol class="results"></ol>
    <div class="suggest">
      <p class="eyebrow">Popular</p>
      <p>{["storm surge", "skysteel", "Tether Accord", "taming", "galleon", "Grudgewood", "stamina"].map((s) => <button type="button" data-s={s}>{s}</button>)}</p>
    </div>
  </div>
</Base>

<script define:vars={{ index: `${base}/search.json` }}>
  const q = document.getElementById("q");
  const list = document.querySelector(".results");
  const status = document.querySelector(".status");
  const suggest = document.querySelector(".suggest");
  let items = null;
  const load = async () => (items ??= await (await fetch(index)).json());
  const esc = (s) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const mark = (s, words) => words.reduce((out, w) => out.replace(new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi"), "<mark>$1</mark>"), esc(s));

  async function run() {
    const term = q.value.trim().toLowerCase();
    history.replaceState(null, "", term ? `?q=${encodeURIComponent(term)}` : location.pathname);
    suggest.hidden = !!term;
    if (!term) { list.innerHTML = ""; status.textContent = ""; return; }
    const words = term.split(/\s+/).filter(Boolean);
    const all = await load();
    const scored = all.map((it) => {
      if (!words.every((w) => it.x.includes(w))) return null;
      const title = it.t.toLowerCase();
      let score = 0;
      for (const w of words) score += title === w ? 50 : title.startsWith(w) ? 25 : title.includes(w) ? 12 : 1;
      if (title === term) score += 100;
      return { it, score };
    }).filter(Boolean).sort((a, b) => b.score - a.score).slice(0, 40);
    status.textContent = scored.length ? `${scored.length}${scored.length === 40 ? "+" : ""} results` : "No results. Try another word.";
    list.innerHTML = scored.map(({ it }) => `<li><a href="${it.u}"><span class="k">${esc(it.k)}</span><b>${mark(it.t, words)}</b><span class="s">${mark(it.s, words)}</span></a></li>`).join("");
  }
  q.addEventListener("input", run);
  document.querySelectorAll("[data-s]").forEach((b) => b.addEventListener("click", () => { q.value = b.dataset.s; run(); }));
  const initial = new URLSearchParams(location.search).get("q");
  if (initial) { q.value = initial; run(); }
</script>

<style>
  .page { max-width: 46rem; padding-top: clamp(1.5rem, 5vw, 3rem); }
  h1 { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
  input { width: 100%; min-height: 54px; font: inherit; font-size: 1.1rem; padding: 0.7rem 1.2rem; border-radius: 14px; border: 1px solid var(--line); background: var(--card); color: var(--ink); box-shadow: var(--shadow); }
  .status { color: var(--ink-faint); font-size: 0.88rem; min-height: 1.4em; }
  .results { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .results :global(a) { display: grid; gap: 0.15rem; padding: 0.85rem 1rem; border-radius: 12px; background: var(--card); box-shadow: 0 0 0 1px var(--line); text-decoration: none; color: var(--ink); }
  .results :global(a:hover) { box-shadow: 0 0 0 1px var(--gold); }
  .results :global(.k) { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal); }
  .results :global(b) { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; }
  .results :global(.s) { font-size: 0.9rem; color: var(--ink-soft); }
  .results :global(mark) { background: color-mix(in srgb, var(--gold) 35%, transparent); color: inherit; border-radius: 3px; padding: 0 0.1em; }
  .suggest { margin-top: 1rem; }
  .suggest p:last-child { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .suggest button { font: 500 0.9rem var(--font-body); min-height: 40px; padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--ink); cursor: pointer; }
</style>
