---
// Old bestiary URLs moved under /catalogue/bestiary/
import { bestiary } from "../../data/bestiary";
import { base } from "../../lib/text";
export function getStaticPaths() { return bestiary.map((c) => ({ params: { id: c.id } })); }
const to = `${base}/catalogue/bestiary/${Astro.params.id}/`;
---
<html lang="en"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0;url=${to}`} /><link rel="canonical" href={to} /><title>Moved</title></head><body><a href={to}>This page moved.</a></body></html>
