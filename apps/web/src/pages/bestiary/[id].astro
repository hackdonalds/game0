---
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import { bestiary, DANGER, REGIONS, type Creature } from "../../data/bestiary";

export function getStaticPaths() {
  return bestiary.map((c, i) => ({
    params: { id: c.id },
    props: { creature: c, prev: bestiary[(i - 1 + bestiary.length) % bestiary.length], next: bestiary[(i + 1) % bestiary.length] },
  }));
}

interface Props { creature: Creature; prev: Creature; next: Creature }
const { creature: c, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const region = REGIONS.find((r) => r.id === c.region)!;
const kin = bestiary.filter((o) => o.region === c.region && o.id !== c.id);
const speed = Object.entries(c.speed).map(([k, v]) => `${k} ${v} m/s`).join(", ");
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const fmt = (n: number) => (n >= 999 && n < 1000 ? "Unlimited" : n.toLocaleString("en-GB"));
---
<Base title={`${c.name} · Bestiary · game0`} description={c.lore}>
  <nav class="crumbs wrap" aria-label="Breadcrumb">
    <a href={`${base}/`}>game0</a><span>/</span>
    <a href={`${base}/bestiary/`}>Bestiary</a><span>/</span>
    <a href={`${base}/bestiary/#${region.id}`}>{region.name}</a>
  </nav>

  <main class="wrap page">
    <div class="art">
      <Plate creature={c} sizes="(max-width: 900px) 100vw, 480px" eager />
      <blockquote>
        <p>“{c.quote.text}”</p>
        <footer>{c.quote.by}</footer>
      </blockquote>
    </div>

    <div class="text">
      <p class="eyebrow">{region.name}</p>
      <h1>{c.name}</h1>
      <p class="lore">{c.lore}</p>

      <article class="stat" aria-label={`${c.name} stat block`}>
        <header>
          <h2>{c.name}</h2>
          <p class="type">{cap(c.size)} {c.family.toLowerCase()}, {c.temperament}</p>
        </header>
        <hr />
        <dl class="core">
          <div><dt>Danger</dt><dd>{c.danger} · {c.boss ? "World boss" : DANGER[c.danger]}</dd></div>
          <div><dt>Health</dt><dd>{fmt(c.health)}</dd></div>
          <div><dt>Stamina</dt><dd>{fmt(c.stamina)}</dd></div>
          <div><dt>Speed</dt><dd>{speed}</dd></div>
        </dl>
        <hr />
        <h3>Skills</h3>
        <ul class="skills">
          {Object.entries(c.skills).map(([name, level]) => (
            <li><span>{name}</span><span class="bar" style={`--v:${level}%`} aria-hidden="true"></span><b>{level}</b></li>
          ))}
        </ul>
        <hr />
        <dl class="lines">
          <div><dt>Senses</dt><dd>{c.senses}</dd></div>
          <div><dt>Active</dt><dd>{c.active}</dd></div>
          <div><dt>Seasons</dt><dd>{c.seasons}</dd></div>
          <div><dt>Habitat</dt><dd>{c.habitat}</dd></div>
          <div><dt>Risk tiers</dt><dd>{c.tiers.map(cap).join(", ")}</dd></div>
          {c.population && <div><dt>Population</dt><dd>{c.population}</dd></div>}
        </dl>
        <hr />
        <h3>Actions</h3>
        <ul class="actions">
          {c.actions.map((a) => <li><b>{a.name}.</b> {a.text}</li>)}
        </ul>
        <h3>Behaviour</h3>
        <p class="chips">{c.behaviours.map((b) => <span>{b}</span>)}</p>
        <hr />
        <dl class="lines">
          <div><dt>Drops</dt><dd>{c.drops.join(", ")}</dd></div>
          {c.taming && <div><dt>Taming</dt><dd>{c.taming.use}, needs Taming {c.taming.skill}</dd></div>}
        </dl>
        {c.storm && (
          <aside class="storm">
            <h3>Storm-touched: {c.storm.name}</h3>
            <p>{c.storm.text}</p>
          </aside>
        )}
      </article>
    </div>
  </main>

  {kin.length > 0 && (
    <section class="wrap kin">
      <h2>Also in {region.name.replace(/^The /, "the ")}</h2>
      <ul>
        {kin.map((o) => (
          <li><a href={`${base}/bestiary/${o.id}/`}><Plate creature={o} sizes="120px" /><span>{o.name}</span></a></li>
        ))}
      </ul>
    </section>
  )}

  <nav class="wrap pager" aria-label="More creatures">
    <a href={`${base}/bestiary/${prev.id}/`}><small>← Previous</small>{prev.name}</a>
    <a href={`${base}/bestiary/`} class="all">All creatures</a>
    <a href={`${base}/bestiary/${next.id}/`} class="next"><small>Next →</small>{next.name}</a>
  </nav>
</Base>

<style>
  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 clamp(16px, 5vw, 48px); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1.5rem; font-size: 0.88rem; color: var(--ink-soft); }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--teal); }
  .crumbs a:first-child { font-family: var(--font-display); font-weight: 600; color: var(--ink); }

  .page { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(1.5rem, 4vw, 3.5rem); padding-top: 2rem; padding-bottom: 3rem; align-items: start; }
  .art { position: sticky; top: 1.5rem; }
  .art :global(.plate) { box-shadow: 0 30px 60px -30px #1d273380; }
  blockquote { margin: 1.5rem 0 0; padding: 0 0 0 1.1rem; border-left: 3px solid var(--gold); }
  blockquote p { margin: 0; font-family: var(--font-display); font-style: italic; font-size: 1.2rem; line-height: 1.4; }
  blockquote footer { margin-top: 0.4rem; font-size: 0.85rem; color: var(--ink-soft); }
  blockquote footer::before { content: "— "; }

  .eyebrow { margin: 0; color: var(--teal); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); margin: 0.3rem 0 1rem; }
  .lore { font-size: 1.1rem; color: #39424d; margin: 0 0 2rem; }

  .stat {
    --rule: #9b3f24;
    background: linear-gradient(180deg, #fbf5e6, #f4e9cf);
    border-top: 5px solid var(--gold); border-bottom: 5px solid var(--gold);
    padding: 1.25rem clamp(1rem, 3vw, 1.6rem) 1.4rem;
    box-shadow: 0 16px 40px -24px #1d273366, 0 0 0 1px #c58a2c33;
    font-size: 0.95rem; line-height: 1.5;
  }
  .stat h2 { margin: 0; font-size: 1.7rem; color: var(--rule); font-variant: small-caps; letter-spacing: 0.02em; }
  .stat .type { margin: 0.1rem 0 0; font-style: italic; color: var(--ink-soft); }
  .stat hr { border: 0; height: 2px; margin: 0.8rem 0; background: linear-gradient(90deg, var(--rule), transparent); }
  .stat h3 { margin: 0.2rem 0 0.4rem; font-size: 1.1rem; color: var(--rule); font-variant: small-caps; letter-spacing: 0.03em; border-bottom: 1px solid #9b3f2440; padding-bottom: 0.15rem; }
  .core { display: grid; grid-template-columns: repeat(4, auto); gap: 0.4rem 1rem; margin: 0; }
  .core dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--rule); }
  .core dd { margin: 0; font-weight: 500; }
  .skills { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .skills li { display: grid; grid-template-columns: 8.5rem 1fr 2.2rem; gap: 0.75rem; align-items: center; }
  .skills .bar { height: 6px; border-radius: 3px; background: linear-gradient(90deg, var(--teal) var(--v), #1d27331a var(--v)); }
  .skills b { text-align: right; font-variant-numeric: tabular-nums; }
  .lines { margin: 0; display: grid; gap: 0.25rem; }
  .lines div { display: grid; grid-template-columns: 7rem 1fr; gap: 0.75rem; }
  .lines dt { font-weight: 600; color: var(--rule); }
  .lines dd { margin: 0; }
  .actions { list-style: none; margin: 0 0 0.8rem; padding: 0; display: grid; gap: 0.45rem; }
  .actions b { font-style: italic; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0; }
  .chips span { font-size: 0.8rem; padding: 0.15rem 0.6rem; border-radius: 999px; background: #1d27330d; border: 1px solid var(--line); }
  .storm { margin-top: 1rem; padding: 0.9rem 1rem; border-radius: 6px; background: linear-gradient(135deg, #2a2445, #3d3566); color: #e9e4ff; }
  .storm h3 { color: #c9bcff; border-color: #c9bcff40; }
  .storm p { margin: 0; }

  .kin { padding-bottom: 2rem; }
  .kin h2 { font-size: 1.4rem; }
  .kin ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem; }
  .kin a { display: grid; gap: 0.4rem; width: 120px; text-decoration: none; color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; line-height: 1.2; }
  .kin a:hover { color: var(--teal); }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; padding-top: 1.5rem; padding-bottom: 5rem; border-top: 1px solid var(--line); }
  .pager a { text-decoration: none; color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; }
  .pager a:hover { color: var(--teal); }
  .pager small { display: block; font-family: var(--font-body); font-weight: 500; font-size: 0.75rem; color: var(--ink-soft); letter-spacing: 0.08em; text-transform: uppercase; }
  .pager .next { text-align: right; }
  .pager .all { font-family: var(--font-body); font-size: 0.85rem; font-weight: 600; padding: 0.5rem 1rem; border: 1px solid var(--line); border-radius: 999px; }

  @media (max-width: 900px) {
    .page { grid-template-columns: 1fr; }
    .art { position: static; max-width: 30rem; }
  }
  @media (max-width: 520px) {
    .core { grid-template-columns: repeat(2, auto); }
    .skills li { grid-template-columns: 6.5rem 1fr 2rem; }
    .lines div { grid-template-columns: 1fr; gap: 0; }
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .all { display: none; }
  }
</style>
