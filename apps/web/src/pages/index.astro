---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Plate from "../components/Plate.astro";
import { chapters } from "../data/chapters.mjs";
import { catalogues } from "../lib/catalogues";
import { decisionLog } from "../lib/decisions";
import { base } from "../lib/text";

const log = await decisionLog();
const decided = log.reduce((n, d) => n + d.decisions.length, 0);
const open = log.reduce((n, d) => n + d.open.length, 0);
const entries = catalogues.reduce((n, c) => n + c.cards.length, 0);
const posts = (await getCollection("devlog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const demos = [
  { title: "The First Shard", text: "Pan and pinch the world map; tap any isle.", href: `${base}/world/#explore`, art: "chapters/world" },
  { title: "Meet the peoples", text: "Turn the three peoples on a carousel.", href: `${base}/peoples/`, art: "chapters/peoples" },
  { title: "Trim a sail", text: "Steer against the wind and find your best speed.", href: `${base}/sailing/`, art: "chapters/sailing" },
  { title: "A living shard", text: "5,000 NPCs at three levels of detail.", href: `${base}/simulation/`, art: "chapters/simulation" },
];
---
<Base title="game0 handbook" section="home">
  <header class="cover">
    <Plate art="chapters/vision" name="The sky isles" sizes="100vw" wide eager class="cover-art" />
    <div class="wrap cover-text">
      <p class="kicker">The handbook</p>
      <h1>The isles are sinking.<br /><em>Three peoples share what is left.</em></h1>
      <p class="lede">The world, the peoples, the rules and the creatures of game0, a sandbox of floating isles above a drowned world. Written down before a line of game code, so whatever we build it with, this is the game.</p>
      <div class="actions">
        <a class="btn primary" href={`${base}/vision/`}>Start reading</a>
        <a class="btn ghost" href={`${base}/catalogue/`}>Browse catalogues</a>
      </div>
    </div>
  </header>

  <section class="wrap stats" aria-label="The handbook in numbers">
    <a href={`${base}/chapters/`}><b>{chapters.length}</b><span>chapters</span></a>
    <a href={`${base}/catalogue/`}><b>{entries}</b><span>catalogue entries</span></a>
    <a href={`${base}/decisions/`}><b>{decided}</b><span>decisions made</span></a>
    <a href={`${base}/decisions/#open`}><b>{open}</b><span>questions open</span></a>
  </section>

  <section class="wrap block">
    <div class="block-head"><p class="eyebrow">Read</p><h2>Chapters</h2><a href={`${base}/chapters/`}>All chapters →</a></div>
    <ol class="chapters">
      {chapters.map((c) => (
        <li>
          <a href={`${base}/${c.slug}/`}>
            <Plate art={`chapters/${c.slug}`} name={c.title} sizes="(max-width: 640px) 85vw, 380px" wide />
            <span class="ch-text"><span class="num">{String(c.number).padStart(2, "0")}</span><b>{c.title}</b><span class="kick">{c.kicker}</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap block">
    <div class="block-head"><p class="eyebrow">Look up</p><h2>Catalogues</h2><a href={`${base}/catalogue/`}>All catalogues →</a></div>
    <ul class="shelf">
      {catalogues.map((c) => (
        <li><a href={`${base}/catalogue/${c.slug}/`}>
          {c.cover ? <Plate art={c.cover} name={c.title} sizes="200px" /> : <span class="blank" data-kind={c.slug}></span>}
          <b>{c.title}</b><span>{c.cards.length} entries</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="wrap block">
    <div class="block-head"><p class="eyebrow">Try</p><h2>Mini demos</h2><a href={`${base}/workshop/`}>Workshop →</a></div>
    <ul class="demos">
      {demos.map((d) => (
        <li><a href={d.href}><Plate art={d.art} name={d.title} sizes="(max-width: 640px) 80vw, 300px" wide /><b>{d.title}</b><span>{d.text}</span></a></li>
      ))}
    </ul>
  </section>

  {posts.length > 0 && (
    <section class="wrap block">
      <div class="block-head"><p class="eyebrow">News</p><h2>Devlog</h2><a href={`${base}/devlog/`}>All posts →</a></div>
      <ul class="posts">
        {posts.map((p) => <li><a href={`${base}/devlog/${p.id}/`}><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><b>{p.data.title}</b><span>{p.data.summary}</span></a></li>)}
      </ul>
    </section>
  )}
</Base>

<style>
  .cover { position: relative; isolation: isolate; color: #fff; }
  .cover :global(.cover-art) { width: 100%; height: clamp(520px, 86vh, 820px); aspect-ratio: auto; border-radius: 0; object-fit: cover; }
  .cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #0b141f99 0%, #0b141f00 65%), linear-gradient(180deg, #0b141f22 0%, #0b141f10 35%, #0b141fdd 100%); pointer-events: none; }
  .cover-text { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding-bottom: clamp(2rem, 6vw, 4.5rem); }
  .kicker { text-shadow: 0 1px 8px #000c; margin: 0 0 0.6rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-light); }
  h1 { font-size: clamp(2.3rem, 7vw, 5rem); margin: 0; max-width: 16ch; color: #fff; text-shadow: 0 2px 24px #0009; }
  h1 em { font-style: italic; font-weight: 400; color: #f3e3bd; }
  .lede { max-width: 38rem; margin: 1rem 0 1.5rem; font-size: clamp(1rem, 2.2vw, 1.15rem); color: #f3ecd9; text-shadow: 0 1px 10px #000a; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0.7rem 1.4rem; border-radius: 999px; font-weight: 600; text-decoration: none; }
  .btn.primary { background: var(--gold-light); color: #1d2733; }
  .btn.primary:hover { background: #fff; }
  .btn.ghost { color: #fff; box-shadow: inset 0 0 0 1.5px #ffffffaa; backdrop-filter: blur(6px); }
  .btn.ghost:hover { background: #ffffff22; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-top: -2.2rem; position: relative; z-index: 2; }
  .stats a { display: grid; padding: 1rem 1.1rem; border-radius: 14px; background: var(--card); box-shadow: var(--shadow), 0 0 0 1px var(--line); text-decoration: none; color: var(--ink); }
  .stats b { font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.3rem); font-weight: 600; line-height: 1; }
  .stats span { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.3rem; }

  .block { margin-top: clamp(3rem, 7vw, 5rem); }
  .block-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1rem; margin-bottom: 1.25rem; }
  .block-head .eyebrow { width: 100%; }
  .block-head h2 { font-size: clamp(1.9rem, 5vw, 2.8rem); margin: 0; }
  .block-head a { margin-left: auto; font-weight: 600; text-decoration: none; font-size: 0.92rem; }

  .chapters { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }
  .chapters a { position: relative; display: block; border-radius: 16px; overflow: hidden; color: #fff; text-decoration: none; box-shadow: var(--shadow); isolation: isolate; }
  .chapters a :global(.plate) { border-radius: 0; transition: transform 0.4s; }
  .chapters a:hover :global(.plate) { transform: scale(1.04); }
  .chapters a::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, #0b141fd9); }
  .ch-text { position: absolute; left: 1rem; right: 1rem; bottom: 0.9rem; z-index: 1; display: grid; }
  .num { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; color: var(--gold-light); }
  .ch-text b { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; line-height: 1.1; }
  .kick { font-size: 0.88rem; color: #f3ecd9cc; }

  .shelf, .demos { list-style: none; margin: 0 calc(var(--gutter) * -1); padding: 0.25rem var(--gutter) 1rem; display: grid; grid-auto-flow: column; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
  .shelf { grid-auto-columns: minmax(9.5rem, 11rem); }
  .demos { grid-auto-columns: minmax(15rem, 19rem); }
  .shelf li, .demos li { scroll-snap-align: start; }
  .shelf a, .demos a { display: grid; gap: 0.35rem; text-decoration: none; color: var(--ink); }
  .shelf b, .demos b { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; margin-top: 0.3rem; }
  .shelf span, .demos span { font-size: 0.85rem; color: var(--ink-soft); }
  .shelf a:hover b, .demos a:hover b { color: var(--teal); }
  .blank { display: block; aspect-ratio: 1; border-radius: 10px; background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--teal) 12%, var(--paper-deep)) 0 12px, var(--paper-deep) 12px 24px); }
  .blank[data-kind="winds"] { background: repeating-linear-gradient(170deg, transparent 0 16px, color-mix(in srgb, #4f86b8 35%, transparent) 16px 18px), linear-gradient(180deg, #cfe6f0, #9fc3dc); }

  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .posts a { display: grid; gap: 0.2rem; padding: 1rem 1.2rem; border-radius: 14px; background: var(--card); box-shadow: 0 0 0 1px var(--line); text-decoration: none; color: var(--ink); }
  .posts time { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--teal); }
  .posts b { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; }
  .posts span { color: var(--ink-soft); font-size: 0.95rem; }

  @media (max-width: 640px) {
    .stats { grid-template-columns: repeat(2, 1fr); margin-top: 1.25rem; }
    .chapters { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 82%; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 1rem; }
    .chapters li { scroll-snap-align: start; }
  }
</style>
