---
import Base from "../layouts/Base.astro";
import { base } from "../lib/text";

type Demo = { title: string; summary: string };
const demos = Object.entries(import.meta.glob<Demo>("../../../../demos/*/demo.json", { eager: true, import: "default" }))
  .map(([path, meta]) => ({ slug: path.split("/").at(-2)!, ...meta }));
const notes: Record<string, string> = {
  "world-editor": "Desktop recommended", creator: "Works on phones", "floating-isle": "Works on phones", "npc-lod": "Heavy: best on a computer",
  roam: "Keyboard: best on a computer", "anim-library": "Works on phones", "peoples-anim": "Works on phones", "rootwarden-anim": "Works on phones", waystone: "Playable quest · works on phones",
};
---
<Base title="Workshop · game0 handbook" description="Full-screen tools and prototypes used to design game0." section="workshop">
  <header class="wrap head">
    <p class="eyebrow">Workshop</p>
    <h1>Tools and prototypes</h1>
    <p class="lede">The full-screen tools behind the handbook. The chapters embed small versions; these are the real things we design with.</p>
  </header>
  <ul class="wrap tools">
    {demos.map((d) => (
      <li>
        <a href={`${base}/demos/${d.slug}/`}>
          <span class="glyph" data-tool={d.slug} aria-hidden="true"></span>
          <span class="text"><b>{d.title}</b><span>{d.summary}</span><small>{notes[d.slug] ?? "Prototype"} · opens full screen ↗</small></span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .head { padding-top: clamp(1.5rem, 5vw, 3rem); }
  h1 { font-size: clamp(2.4rem, 7vw, 4rem); margin: 0.2rem 0 0.5rem; }
  .lede { max-width: 40rem; margin: 0 0 2rem; color: var(--ink-soft); font-size: 1.1rem; }
  .tools { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 1rem; }
  .tools a { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; align-items: start; height: 100%; padding: 1.2rem; border-radius: 16px; background: var(--card); box-shadow: 0 0 0 1px var(--line); text-decoration: none; color: var(--ink); transition: transform 0.15s, box-shadow 0.15s; }
  .tools a:hover { transform: translateY(-2px); box-shadow: var(--shadow), 0 0 0 1px var(--gold); }
  .glyph { width: 4.5rem; height: 4.5rem; border-radius: 14px; background: linear-gradient(135deg, var(--teal), color-mix(in srgb, var(--teal) 40%, var(--gold))); position: relative; }
  .glyph::after { position: absolute; inset: 0; display: grid; place-items: center; font-size: 1.9rem; color: #fff; }
  .glyph[data-tool="world-editor"]::after { content: "✎"; }
  .glyph[data-tool="creator"]::after { content: "☺"; }
  .glyph[data-tool="floating-isle"]::after { content: "▲"; }
  .glyph[data-tool="npc-lod"]::after { content: "⁂"; }
  .glyph[data-tool="roam"]::after { content: "➶"; }
  .glyph[data-tool="anim-library"]::after { content: "▶"; }
  .glyph[data-tool="peoples-anim"]::after, .glyph[data-tool="rootwarden-anim"]::after { content: "♞"; }
  .text { display: grid; gap: 0.3rem; }
  b { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; }
  .text span { color: var(--ink-soft); font-size: 0.95rem; }
  small { font-size: 0.8rem; font-weight: 600; color: var(--teal); }
</style>
